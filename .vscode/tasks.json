{
  "version": "2.0.0",
  // Every task here is also a command-palette entry: Cmd+Shift+P, "Tasks: Run
  // Task", then the label. The friendlier "Agents: Start / Restart / Attach"
  // entries come from the local extension in scripts/agents/vscode, which runs
  // the task of the same label — so these three labels are an interface and
  // must not be renamed on their own.
  //
  // Each command is guarded, because this file travels between projects and
  // repositories without scripts/agents/start-agents.sh must not get a failing
  // task on open or a confusing one in the palette.
  "tasks": [
    {
      "label": "start-agents",
      "type": "shell",
      // No Dev Container here: Xcode and the Simulator run on the host, so this
      // folderOpen task is the only startup hook the session has.
      // The integrated terminal has a real TTY, so attaching from it puts the
      // orchestrator / implementer / reviewer panes inside VS Code. (Claude
      // Code's Bash tool has no TTY and cannot attach.)
      "command": "[ -x scripts/agents/start-agents.sh ] && exec scripts/agents/start-agents.sh || true",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        // This terminal owns tmux: never auto-close it, and do not echo the command.
        "reveal": "always",
        "panel": "dedicated",
        "echo": false,
        "close": false,
        "clear": true,
        // Show it without stealing focus from the editor.
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "restart-agents",
      "type": "shell",
      // A model or a role prompt is read when claude starts, so a running seat
      // keeps the old one until it is respawned. --restart replaces what runs
      // inside each pane and leaves the session alone, so the terminal opened
      // on folderOpen survives. --no-attach is what keeps this task from
      // falling through to `tmux attach` afterwards and opening a second view
      // of the same session: a task runs outside tmux, where nothing else
      // stops the attach.
      //
      // It ends whatever the agents were in the middle of. Their conversations
      // do not survive, so run it between pieces of work rather than during one.
      "command": "[ -x scripts/agents/start-agents.sh ] && scripts/agents/start-agents.sh --restart --no-attach || true",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        // The result is visible in the start-agents terminal, so this one has
        // nothing worth showing and closes itself unless it fails.
        "reveal": "silent",
        "panel": "shared",
        "echo": false,
        "close": true,
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "attach-agents",
      "type": "shell",
      // Get a view of the session back after closing the start-agents terminal.
      // The script attaches to the session when one is running and builds it when
      // none is, so this is also the way back from an accidental kill.
      "command": "[ -x scripts/agents/start-agents.sh ] && exec scripts/agents/start-agents.sh || true",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "echo": false,
        "close": false,
        "clear": true,
        // Asked for by hand, unlike start-agents, so take the focus.
        "focus": true
      },
      "problemMatcher": []
    }
  ]
}
