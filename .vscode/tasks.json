{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start-agents",
      "type": "shell",
      // No Dev Container here: Xcode and the Simulator run on the host.
      // The integrated terminal has a real TTY, so attaching from it puts the
      // orchestrator / implementer / reviewer panes inside VS Code. (Claude
      // Code's Bash tool has no TTY and cannot attach.)
      "command": "./scripts/agents/start-agents.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        // This terminal owns tmux: never auto-close it, and do not echo the command.
        "echo": false,
        "close": false,
        "clear": true,
        // Show it without stealing focus from the editor.
        "focus": false
      },
      "problemMatcher": []
    },
    {
      // A model or a role prompt is read when claude starts, so a running seat
      // keeps the old one until it is respawned. --restart replaces what runs
      // inside each pane and leaves the session alone, so the terminal opened
      // on folderOpen survives. Run this by hand, never on folderOpen.
      "label": "restart-agents",
      "type": "shell",
      "command": "./scripts/agents/start-agents.sh --restart",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "echo": false,
        "clear": true,
        "focus": false
      },
      "problemMatcher": []
    }
  ]
}
