{
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.git": true,
    "**/xcuserdata": true,
    "**/*.xcuserstate": true,
    "**/*.hmap": true,
    ".build": true,
    "DerivedData": true,
    "build": true,
    "build.log": true,
    "out": true,
    "node_modules": true,
    ".swiftpm": true,
    "Package.resolved": true,
    ".claude/settings.local.json": true,
    ".claude/worktrees": true
  },
  "search.exclude": {
    ".build": true,
    "DerivedData": true,
    "out": true,
    "node_modules": true
  },
  "files.watcherExclude": {
    "**/.build/**": true,
    "**/DerivedData/**": true,
    "**/out/**": true
  },
  "[swift]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "vknabel.vscode-apple-swift-format"
  }
}
