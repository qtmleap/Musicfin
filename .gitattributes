# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Source
*.swift     text
*.h         text
*.m         text
*.json      text
*.jsonc     text
*.yaml      text
*.yml       text
*.md        text
*.sh        text eol=lf
*.zsh       text eol=lf

# Xcode
# pbxproj は Xcode が独自形式で書き換えるため、差分表示だけ抑えて中身は素通しにする。
*.pbxproj       text -diff merge=union
*.xcscheme      text
*.xcworkspacedata text
*.plist         text
*.entitlements  text
*.xcconfig      text

# Binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.car       binary
*.ipa       binary
*.xcarchive binary
