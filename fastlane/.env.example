# App Store Connect API Key（ユーザとアクセス → 統合 → App Store Connect API）
ASC_KEY_ID=
ASC_ISSUER_ID=
# .p8 の絶対パス。CI では代わりに ASC_KEY_CONTENT（base64）を渡す
ASC_KEY_FILEPATH=

# match リポジトリ (qtmleap/match) の暗号化パスフレーズ
MATCH_PASSWORD=
# private リポジトリを読むための Basic 認証。`echo -n "user:token" | base64`
MATCH_GIT_BASIC_AUTHORIZATION=
